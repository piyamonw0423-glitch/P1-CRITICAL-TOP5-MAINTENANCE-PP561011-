{
  "name": "p1-repair-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:server": "vite build --mode api",
    "start": "node server/index.js",
