// Cloudflare Worker config. Deploy: Workers & Pages → Create → Import a repository,
// build command `npm run build:server`, deploy command `npx wrangler deploy`.
// Secrets/variables (Settings → Variables and Secrets):
//   DATABASE_URL (secret)                 Neon pooled connection string
//   EDIT_PASSWORD (secret, optional)      team password for editing
//   ACCESS_TEAM_DOMAIN, ACCESS_AUD        optional Cloudflare Access login (company email)
//   EDITOR_EMAILS (optional)              comma-separated editors when Access is on
//   LINE_CHANNEL_ACCESS_TOKEN, LINE_TO    (secrets, optional) LINE summary after each CMMS upload + reminders
//   LINE_CHANNEL_SECRET                   (secret, optional) LINE webhook: replies to "สรุป" / "id"
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p1-critical-top5-maintenance-pp561011",
  "main": "worker/index.js",
  // Always build the shared-data (API) version of the site before deploying, whatever
  // build command the Cloudflare dashboard has; the plain build would keep data per browser.
  "build": { "command": "npm run build:server" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Serve on <name>.<account>.workers.dev; no per-version preview URLs (they would skip Access).
  "workers_dev": true,
  "preview_urls": false,
  // Keep variables added in the Cloudflare dashboard across deploys (secrets are always kept).
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Link used in LINE messages sent by the cron reminder (requests use their own origin).
  "vars": { "PUBLIC_URL": "https://p1-critical-top5-maintenance-pp561011.piyamon-w0423.workers.dev/" },
  // LINE reminder if the day's CMMS file (reported once a day at ~16:30) was not uploaded: 16:45 Thai time (09:45 UTC), Mon–Sat.
  "triggers": { "crons": ["45 9 * * MON-SAT"] },
  "observability": { "enabled": true }
}
